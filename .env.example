APP_ENV=development
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=10s
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=65536
API_DOCS_ENABLED=true
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_service?sslmode=disable
JWT_ISSUER=auth-service
JWT_AUDIENCE=auth-api
JWT_PUBLIC_KEY_PATH=certs/jwt.public.pem
JWT_PRIVATE_KEY_PATH=certs/jwt.private.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
